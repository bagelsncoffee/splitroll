#include <winver.h>
1 ICON "icon.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @V1@,@V2@,@V3@,0
PRODUCTVERSION  @V1@,@V2@,@V3@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "@PUBLISHER@"
      VALUE "FileDescription",  "splitroll — half-frame film scan splitter"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "InternalName",     "splitroll"
      VALUE "LegalCopyright",   "@PUBLISHER@"
      VALUE "OriginalFilename", "splitroll.exe"
      VALUE "ProductName",      "splitroll"
      VALUE "ProductVersion",   "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
